{
  "name": "fpure",
  "version": "0.2.8",
  "description": "Pure, curried, functional programming utilities for TypeScript.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./function": {
      "types": "./dist/function/index.d.ts",
      "require": "./dist/function/index.js",
      "default": "./dist/function/index.js"
    },
    "./list": {
      "types": "./dist/list/index.d.ts",
      "require": "./dist/list/index.js",
      "default": "./dist/list/index.js"
    },
    "./logic": {
      "types": "./dist/logic/index.d.ts",
      "require": "./dist/logic/index.js",
      "default": "./dist/logic/index.js"
    },
    "./math": {
      "types": "./dist/math/index.d.ts",
      "require": "./dist/math/index.js",
      "default": "./dist/math/index.js"
    },
    "./object": {
      "types": "./dist/object/index.d.ts",
      "require": "./dist/object/index.js",
      "default": "./dist/object/index.js"
    },
    "./relation": {
      "types": "./dist/relation/index.d.ts",
      "require": "./dist/relation/index.js",
      "default": "./dist/relation/index.js"
    },
    "./string": {
      "types": "./dist/string/index.d.ts",
      "require": "./dist/string/index.js",
      "default": "./dist/string/index.js"
    },
    "./type": {
      "types": "./dist/type/index.d.ts",
      "require": "./dist/type/index.js",
      "default": "./dist/type/index.js"
    },
    "./function/*": {
      "types": "./dist/function/*.d.ts",
      "require": "./dist/function/*.js",
      "default": "./dist/function/*.js"
    },
    "./list/*": {
      "types": "./dist/list/*.d.ts",
      "require": "./dist/list/*.js",
      "default": "./dist/list/*.js"
    },
    "./logic/*": {
      "types": "./dist/logic/*.d.ts",
      "require": "./dist/logic/*.js",
      "default": "./dist/logic/*.js"
    },
    "./math/*": {
      "types": "./dist/math/*.d.ts",
      "require": "./dist/math/*.js",
      "default": "./dist/math/*.js"
    },
    "./object/*": {
      "types": "./dist/object/*.d.ts",
      "require": "./dist/object/*.js",
      "default": "./dist/object/*.js"
    },
    "./relation/*": {
      "types": "./dist/relation/*.d.ts",
      "require": "./dist/relation/*.js",
      "default": "./dist/relation/*.js"
    },
    "./string/*": {
      "types": "./dist/string/*.d.ts",
      "require": "./dist/string/*.js",
      "default": "./dist/string/*.js"
    },
    "./type/*": {
      "types": "./dist/type/*.d.ts",
      "require": "./dist/type/*.js",
      "default": "./dist/type/*.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test spec/*.test.cjs",
    "coverage": "npm run build && c8 --reporter=lcov --reporter=text node --test spec/*.test.cjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "tsc"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/seancannon/fpure.git"
  },
  "keywords": [
    "fp",
    "functional programming",
    "ramda",
    "haskell",
    "pure functions",
    "pure",
    "fpure",
    "typescript",
    "sanctuary"
  ],
  "author": "Sean Cannon",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/seancannon/fpure/issues"
  },
  "homepage": "https://github.com/seancannon/fpure",
  "devDependencies": {
    "c8": "^11.0.0",
    "typescript": "^6.0.0"
  }
}

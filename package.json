{
  "name": "fpure",
  "version": "0.2.9",
  "description": "Pure, curried, functional programming utilities for TypeScript.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": "./dist/index.js"
    },
    "./function": {
      "import": {
        "types": "./dist/esm/function/index.d.ts",
        "default": "./dist/esm/function/index.js"
      },
      "require": {
        "types": "./dist/function/index.d.ts",
        "default": "./dist/function/index.js"
      },
      "default": "./dist/function/index.js"
    },
    "./list": {
      "import": {
        "types": "./dist/esm/list/index.d.ts",
        "default": "./dist/esm/list/index.js"
      },
      "require": {
        "types": "./dist/list/index.d.ts",
        "default": "./dist/list/index.js"
      },
      "default": "./dist/list/index.js"
    },
    "./logic": {
      "import": {
        "types": "./dist/esm/logic/index.d.ts",
        "default": "./dist/esm/logic/index.js"
      },
      "require": {
        "types": "./dist/logic/index.d.ts",
        "default": "./dist/logic/index.js"
      },
      "default": "./dist/logic/index.js"
    },
    "./math": {
      "import": {
        "types": "./dist/esm/math/index.d.ts",
        "default": "./dist/esm/math/index.js"
      },
      "require": {
        "types": "./dist/math/index.d.ts",
        "default": "./dist/math/index.js"
      },
      "default": "./dist/math/index.js"
    },
    "./object": {
      "import": {
        "types": "./dist/esm/object/index.d.ts",
        "default": "./dist/esm/object/index.js"
      },
      "require": {
        "types": "./dist/object/index.d.ts",
        "default": "./dist/object/index.js"
      },
      "default": "./dist/object/index.js"
    },
    "./relation": {
      "import": {
        "types": "./dist/esm/relation/index.d.ts",
        "default": "./dist/esm/relation/index.js"
      },
      "require": {
        "types": "./dist/relation/index.d.ts",
        "default": "./dist/relation/index.js"
      },
      "default": "./dist/relation/index.js"
    },
    "./string": {
      "import": {
        "types": "./dist/esm/string/index.d.ts",
        "default": "./dist/esm/string/index.js"
      },
      "require": {
        "types": "./dist/string/index.d.ts",
        "default": "./dist/string/index.js"
      },
      "default": "./dist/string/index.js"
    },
    "./type": {
      "import": {
        "types": "./dist/esm/type/index.d.ts",
        "default": "./dist/esm/type/index.js"
      },
      "require": {
        "types": "./dist/type/index.d.ts",
        "default": "./dist/type/index.js"
      },
      "default": "./dist/type/index.js"
    },
    "./function/*": {
      "import": {
        "types": "./dist/esm/function/*.d.ts",
        "default": "./dist/esm/function/*.js"
      },
      "require": {
        "types": "./dist/function/*.d.ts",
        "default": "./dist/function/*.js"
      },
      "default": "./dist/function/*.js"
    },
    "./list/*": {
      "import": {
        "types": "./dist/esm/list/*.d.ts",
        "default": "./dist/esm/list/*.js"
      },
      "require": {
        "types": "./dist/list/*.d.ts",
        "default": "./dist/list/*.js"
      },
      "default": "./dist/list/*.js"
    },
    "./logic/*": {
      "import": {
        "types": "./dist/esm/logic/*.d.ts",
        "default": "./dist/esm/logic/*.js"
      },
      "require": {
        "types": "./dist/logic/*.d.ts",
        "default": "./dist/logic/*.js"
      },
      "default": "./dist/logic/*.js"
    },
    "./math/*": {
      "import": {
        "types": "./dist/esm/math/*.d.ts",
        "default": "./dist/esm/math/*.js"
      },
      "require": {
        "types": "./dist/math/*.d.ts",
        "default": "./dist/math/*.js"
      },
      "default": "./dist/math/*.js"
    },
    "./object/*": {
      "import": {
        "types": "./dist/esm/object/*.d.ts",
        "default": "./dist/esm/object/*.js"
      },
      "require": {
        "types": "./dist/object/*.d.ts",
        "default": "./dist/object/*.js"
      },
      "default": "./dist/object/*.js"
    },
    "./relation/*": {
      "import": {
        "types": "./dist/esm/relation/*.d.ts",
        "default": "./dist/esm/relation/*.js"
      },
      "require": {
        "types": "./dist/relation/*.d.ts",
        "default": "./dist/relation/*.js"
      },
      "default": "./dist/relation/*.js"
    },
    "./string/*": {
      "import": {
        "types": "./dist/esm/string/*.d.ts",
        "default": "./dist/esm/string/*.js"
      },
      "require": {
        "types": "./dist/string/*.d.ts",
        "default": "./dist/string/*.js"
      },
      "default": "./dist/string/*.js"
    },
    "./type/*": {
      "import": {
        "types": "./dist/esm/type/*.d.ts",
        "default": "./dist/esm/type/*.js"
      },
      "require": {
        "types": "./dist/type/*.d.ts",
        "default": "./dist/type/*.js"
      },
      "default": "./dist/type/*.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc && tsc -p tsconfig.esm.json && node scripts/write-esm-package.cjs",
    "test": "npm run build && node --test spec/*.test.cjs",
    "coverage": "npm run build && c8 --reporter=lcov --reporter=text node --test spec/*.test.cjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/seancannon/fpure.git"
  },
  "keywords": [
    "fp",
    "functional programming",
    "ramda",
    "haskell",
    "pure functions",
    "pure",
    "fpure",
    "typescript",
    "sanctuary"
  ],
  "author": "Sean Cannon",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/seancannon/fpure/issues"
  },
  "homepage": "https://github.com/seancannon/fpure",
  "devDependencies": {
    "c8": "^11.0.0",
    "typescript": "^6.0.0"
  }
}
